              "-Djava.library.path=libs:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "core"]}
  :clear-code-dev
  {:extra-deps {nrepl/nrepl {:mvn/version "1.5.2"}
                cider/cider-nrepl {:mvn/version "0.58.0"}
