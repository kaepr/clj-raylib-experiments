                refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                        ; copied from https://github.com/ertugrulcetin/raylib-clojure-playground/blob/master/project.clj
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "clear-code.main"]}}}
